<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:background="#121212">

    <!-- GAME TITLE -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="⚡ REACTION BATTLE"
        android:textColor="#FFFFFF"
        android:textSize="27sp"
        android:textStyle="bold" />

    <!-- ROUND -->

    <TextView
        android:id="@+id/txtReactionRound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="ROUND 1 / 3"
        android:textColor="#BDBDBD"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- PLAYER 1: TOP HALF -->

    <Button
        android:id="@+id/btnReactionP1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="🔴 PLAYER 1"
        android:textSize="22sp"
        android:enabled="false" />

    <!-- CENTER AREA -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- STATUS / SIGNAL -->

        <TextView
            android:id="@+id/txtReactionStatus"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:gravity="center"
            android:text="READY FOR BATTLE?"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- REACTION TIMES -->

        <TextView
            android:id="@+id/txtReactionTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="P1: --- ms     P2: --- ms"
            android:textColor="#BDBDBD"
            android:textSize="16sp" />

        <!-- START / NEXT ROUND / PLAY AGAIN -->

        <Button
            android:id="@+id/btnReactionStart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="⚔️ START BATTLE"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- PLAYER 2: BOTTOM HALF -->

    <Button
        android:id="@+id/btnReactionP2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="🔵 PLAYER 2"
        android:textSize="22sp"
        android:enabled="false" />

    <!-- BACK -->

    <Button
        android:id="@+id/btnReactionBack"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="← BACK"
        android:textSize="16sp" />

</LinearLayout>
