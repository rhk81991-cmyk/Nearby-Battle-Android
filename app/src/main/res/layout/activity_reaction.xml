<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#121212">

    <!-- GAME TITLE -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ REACTION BATTLE"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- ROUND -->

    <TextView
        android:id="@+id/txtReactionRound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ROUND 1 / 3"
        android:textColor="#BDBDBD"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- STATUS -->

    <TextView
        android:id="@+id/txtReactionStatus"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="READY FOR BATTLE?"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- REACTION TIMES -->

    <TextView
        android:id="@+id/txtReactionTimes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="P1: --- ms     P2: --- ms"
        android:textColor="#BDBDBD"
        android:textSize="17sp" />

    <!-- PLAYER 1 -->

    <Button
        android:id="@+id/btnReactionP1"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="24dp"
        android:text="🔴 PLAYER 1"
        android:textSize="20sp"
        android:enabled="false" />

    <!-- PLAYER 2 -->

    <Button
        android:id="@+id/btnReactionP2"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:text="🔵 PLAYER 2"
        android:textSize="20sp"
        android:enabled="false" />

    <!-- START / NEXT ROUND -->

    <Button
        android:id="@+id/btnReactionStart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:text="⚔️ START BATTLE"
        android:textSize="18sp" />

    <!-- BACK -->

    <Button
        android:id="@+id/btnReactionBack"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="← BACK"
        android:textSize="16sp" />

</LinearLayout>
