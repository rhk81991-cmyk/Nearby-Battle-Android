<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✊ ROCK PAPER SCISSORS ✌️"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/txtRpsRound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ROUND 1 / 5"
        android:textColor="#BDBDBD"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txtRpsScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="P1: 0     P2: 0     Draws: 0"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtRpsStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="12dp"
        android:text="PLAYER 1: CHOOSE YOUR MOVE"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRpsRock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="✊ ROCK"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnRpsPaper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="✋ PAPER"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnRpsScissors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="✌️ SCISSORS"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnRpsNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NEXT ROUND"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRpsBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="← BACK" />

</LinearLayout>
