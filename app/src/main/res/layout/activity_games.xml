<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="🎮  GAME HUB"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Choose your battle"
        android:textColor="#BDBDBD"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnTapWar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:text="⚔️  TAP WAR"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnReaction"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="⚡  REACTION BATTLE"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnRPS"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="✊  ROCK PAPER SCISSORS"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnNumberRush"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="🔢  NUMBER RUSH"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnGamesBack"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="30dp"
        android:text="← BACK"
        android:textSize="16sp" />

</LinearLayout>
